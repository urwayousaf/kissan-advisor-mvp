# Must be the same value as JWT_SECRET in the Node API (the service refuses to start without it)
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS (localhost:5173 is always allowed)
CORS_ORIGINS=https://your-app.vercel.app

# Optional. Hosts such as Render/Railway set PORT for you.
# HOST=0.0.0.0
# PORT=8000
