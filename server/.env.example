# Required in production (the server exits on startup if these are missing)
MONGO_URL=mongodb://127.0.0.1:27017/kissanAdvisor
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The AI service must use the same value.
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS (localhost:5173 is always allowed)
CORS_ORIGINS=https://your-app.vercel.app

# Set NODE_ENV=production on the host to enable the checks above
# NODE_ENV=production

# Agriculture officers self-register with this code (unset = officer registration disabled)
OFFICER_INVITE_CODE=

# First admin account, created at startup if it doesn't exist (password >= 8 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

OPENAI_API_KEY=
